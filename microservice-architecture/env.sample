# Copy to your shell / IDE run configuration — never commit real secrets.
# JWT must be >= 32 bytes. Example: openssl rand -base64 48

JWT_SECRET=
DB_USERNAME=root
DB_PASSWORD=

# auth-service: set SPRING_PROFILES_ACTIVE=local to use application-local.yml (gitignored) for Gmail/admin/JWT.
# Example (PowerShell): $env:SPRING_PROFILES_ACTIVE='local'; cd auth-service; .\mvnw.cmd spring-boot:run
# Gmail: MAIL_USERNAME = full address (e.g. hireconnect.platform@gmail.com).
# MAIL_PASSWORD = 16-char App Password from Google Account → Security → App passwords (NOT your login password).
# ADMIN_EMAIL should usually be the same inbox you read for approvals (often = MAIL_USERNAME).
MAIL_USERNAME=
MAIL_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
ADMIN_EMAIL=
ADMIN_PASSWORD=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Subscription-service invoice emails (same Gmail app password pattern as auth if you use Gmail SMTP)
# MAIL_USERNAME=
# MAIL_PASSWORD=
